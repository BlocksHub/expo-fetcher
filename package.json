{
  "name": "expo-fetcher",
  "version": "1.0.0",
  "description": "Native fetch for Expo and React Native: URLSession on iOS, OkHttp on Android, with streaming, progress, retries and SSL pinning.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "files": [
    "build",
    "ios",
    "android",
    "expo-module.config.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "lint": "expo-module lint",
    "test": "jest",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly",
    "expo-module": "expo-module",
    "buildandpack": "npm run clean && tsc && npm pack",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "expo",
    "fetch",
    "http",
    "okhttp",
    "urlsession",
    "ssl-pinning",
    "streaming",
    "upload"
  ],
  "repository": "https://github.com/blockshub/expo-fetcher",
  "bugs": {
    "url": "https://github.com/blockshub/expo-fetcher/issues"
  },
  "author": "Blocks <68423470+tryon-dev@users.noreply.github.com> (https://github.com/tryon-dev)",
  "license": "MIT",
  "homepage": "https://github.com/blockshub/expo-fetcher#readme",
  "dependencies": {},
  "devDependencies": {
    "@types/react": "~19.1.0",
    "expo": "^54.0.18",
    "expo-module-scripts": "^5.0.7",
    "react-native": "0.81.5"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "jest": {
    "preset": "jest-expo/node",
    "setupFilesAfterEnv": [
      "<rootDir>/src/__tests__/setup.ts"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*-test.ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/build/",
      "<rootDir>/example/"
    ]
  }
}
